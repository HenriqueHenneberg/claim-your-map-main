generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TerritoryType {
  GLOBAL
  COUNTRY
  STATE
  CITY
}

enum TerritoryStatus {
  NONE
  ACTIVE
  COMPETITIVE
  DOMINATED
  WAR
}

enum PaymentProvider {
  MERCADOPAGO
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  REFUNDED
}

enum RankEventType {
  TERRITORY_TAKEN
  USER_PASSED
  TOP_10_ENTERED
  PAYMENT_APPROVED
  WAR_STARTED
}

model User {
  id              String           @id @default(cuid())
  publicName      String
  slug            String           @unique
  message         String?
  country         String
  state           String?
  city            String?
  totalPoints     Int              @default(0)
  totalPaidCents  Int              @default(0)
  isBanned        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  ownedTerritories Territory[]     @relation("TerritoryOwner")
  scores          TerritoryScore[]
  payments        Payment[]
  events          RankEvent[]

  @@index([totalPoints, createdAt])
  @@index([country, state, city])
}

model Territory {
  id               String             @id @default(cuid())
  slug             String             @unique
  name             String
  type             TerritoryType
  country          String?
  state            String?
  city             String?
  latitude         Float?
  longitude        Float?
  status           TerritoryStatus    @default(NONE)
  ownerId          String?
  totalPoints      Int                @default(0)
  totalAmountCents Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  owner            User?              @relation("TerritoryOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  scores           TerritoryScore[]
  payments         Payment[]
  events           RankEvent[]

  @@index([type, country, state, city])
  @@index([status])
  @@index([ownerId])
}

model TerritoryScore {
  id            String    @id @default(cuid())
  userId        String
  territoryId   String
  points        Int       @default(0)
  amountCents   Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  territory     Territory @relation(fields: [territoryId], references: [id], onDelete: Cascade)

  @@unique([userId, territoryId])
  @@index([territoryId, points, createdAt])
  @@index([userId])
}

model Payment {
  id                 String          @id @default(cuid())
  userId             String
  territoryId        String
  provider           PaymentProvider @default(MERCADOPAGO)
  providerPaymentId  String?         @unique
  amountCents        Int
  points             Int
  status             PaymentStatus   @default(PENDING)
  pixQrCode          String?
  pixQrCodeBase64    String?
  pixCopyPaste       String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  approvedAt         DateTime?
  user               User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  territory          Territory       @relation(fields: [territoryId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([userId])
  @@index([territoryId])
}

model RankEvent {
  id          String        @id @default(cuid())
  userId      String?
  territoryId String?
  type        RankEventType
  text        String
  country     String?
  state       String?
  city        String?
  createdAt   DateTime      @default(now())
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  territory   Territory?    @relation(fields: [territoryId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([country, state, city])
  @@index([territoryId])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  actor     String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}

model BannedWord {
  id        String   @id @default(cuid())
  word      String   @unique
  createdAt DateTime @default(now())
}
